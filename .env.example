JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Локальный HTTP: false. На сервере с HTTPS обязательно true.
COOKIE_SECURE=false

# Password recovery. file: local .eml files in .local/mail, no real email delivery.
PASSWORD_RESET_URL=http://localhost:5173/reset-password
MAIL_MODE=file
MAIL_FROM=Finance Tracker <no-reply@localhost>
# For a local mail catcher: smtp / localhost / 1025 / none.
# For a real provider: smtp / provider host / 587 / starttls (or 465 / ssl).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
